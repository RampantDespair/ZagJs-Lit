{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "zagjs-lit",
  "version": "0.1.0",
  "description": "Lit framework adapter for Zag state machines.",
  "keywords": [
    "lit",
    "web-components",
    "zag",
    "state-machines"
  ],
  "homepage": "https://github.com/RampantDespair/ZagJs-Lit#readme",
  "bugs": {
    "url": "https://github.com/RampantDespair/ZagJs-Lit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RampantDespair/ZagJs-Lit.git"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zag-js/core": "^1.44.0",
    "@zag-js/store": "^1.44.0",
    "@zag-js/types": "^1.44.0",
    "@zag-js/utils": "^1.44.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "^5.0.3",
    "@zag-js/checkbox": "^1.44.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-perfectionist": "^5.12.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "prettier-plugin-packagejson": "^3.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "lit": "^3.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
